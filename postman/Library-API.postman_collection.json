{
  "info": {
    "name": "Library Management System API",
    "description": "Every endpoint in API.md. Start MySQL in XAMPP and `php artisan serve` first. Once sign-in exists, send 1. Sign-in → Get CSRF cookie, then a Log in request. Each request says who may call it. Example IDs match the sample data in database/04_seed.sql; reload it with `bash database/reset.sh` after testing requests that change data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Laravel sends a fresh XSRF-TOKEN cookie with its answers.",
          "// Save it, so POST, PATCH and DELETE can send it back in the X-XSRF-TOKEN header.",
          "const token = pm.cookies.get('XSRF-TOKEN');",
          "if (token) {",
          "  pm.collectionVariables.set('xsrfToken', decodeURIComponent(token));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "frontendUrl",
      "value": "http://localhost:5173"
    },
    {
      "key": "xsrfToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Sign-in",
      "item": [
        {
          "name": "Get CSRF cookie",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Referer",
                "value": "{{frontendUrl}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/sanctum/csrf-cookie",
            "description": "Who may call it: anyone. Send this first, before Log in or Register. It answers 204 with no body; that is normal."
          }
        },
